7:[["$","$Lf",null,{}],["$","div",null,{"ref":"$undefined","className":"sm:px-8 mt-16 sm:mt-32","children":["$","div",null,{"className":"mx-auto w-full max-w-7xl lg:px-8","children":["$","div",null,{"ref":"$undefined","className":"relative px-4 sm:px-8 lg:px-12","children":["$","div",null,{"className":"mx-auto max-w-2xl lg:max-w-5xl","children":[["$","$L5",null,{"href":"/en/projects","className":"text-sm font-medium text-orange-500 transition hover:text-orange-600 dark:hover:text-orange-400","children":"Back to projects"}],["$","div",null,{"className":"mt-10 grid gap-16 lg:grid-cols-[minmax(0,1fr)_20rem]","children":[["$","article",null,{"children":[["$","p",null,{"className":"text-sm font-semibold uppercase tracking-[0.32em] text-orange-500","children":"Python Developer"}],["$","h1",null,{"className":"mt-4 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100","children":"Cap Analyzer (UV Sealer)"}],["$","p",null,{"className":"mt-6 max-w-3xl text-base leading-7 text-zinc-600 dark:text-zinc-400","children":"Built a Python desktop operations tool that connects to the UV sealer robot, captures per-cap load-cell traces, runs pass/fail analysis, and stores searchable batch history."}],["$","div",null,{"className":"relative mt-10 aspect-[16/9] overflow-hidden rounded-3xl bg-zinc-100 dark:bg-zinc-800","children":["$","img",null,{"src":"/uvcap.png","alt":"Cap Analyzer (UV Sealer)","className":"h-full w-full object-cover"}]}],["$","div",null,{"className":"mt-12 space-y-12","children":[["$","section","Problem",{"children":[["$","h2",null,{"className":"text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100","children":"Problem"}],["$","div",null,{"className":"mt-4 space-y-5 text-base leading-7 text-zinc-600 dark:text-zinc-400","children":[["$","p","Cap quality checks needed faster and repeatable analysis, with immediate visibility into pass/fail state and trace curves.",{"children":"Cap quality checks needed faster and repeatable analysis, with immediate visibility into pass/fail state and trace curves."}],["$","p","Historical batch lookup and debugging were difficult without centralized storage, and real-time collection/review needed one interface.",{"children":"Historical batch lookup and debugging were difficult without centralized storage, and real-time collection/review needed one interface."}]]}]]}],["$","section","Role and ownership",{"children":[["$","h2",null,{"className":"text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100","children":"Role and ownership"}],["$","div",null,{"className":"mt-4 space-y-5 text-base leading-7 text-zinc-600 dark:text-zinc-400","children":[["$","p","I owned full-stack Python implementation: CustomTkinter/Tkinter UI, robot communication via faroc, MongoDB persistence/search, and analysis logic.",{"children":"I owned full-stack Python implementation: CustomTkinter/Tkinter UI, robot communication via faroc, MongoDB persistence/search, and analysis logic."}],["$","p","I built operator workflows, per-cap graphing, and trace normalization/interpolation pipelines.",{"children":"I built operator workflows, per-cap graphing, and trace normalization/interpolation pipelines."}]]}]]}],["$","section","Architecture and features",{"children":[["$","h2",null,{"className":"text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100","children":"Architecture and features"}],["$","div",null,{"className":"mt-4 space-y-5 text-base leading-7 text-zinc-600 dark:text-zinc-400","children":[["$","p","Desktop frontend/UI with CustomTkinter, Tkinter, tkcalendar, and Matplotlib in a single-process Python app layer.",{"children":"Desktop frontend/UI with CustomTkinter, Tkinter, tkcalendar, and Matplotlib in a single-process Python app layer."}],["$","p","MongoDB (uv_sealer database, batches collection) stores batch and cap traces; FANUC robot integration runs through FaRoC_Writer.",{"children":"MongoDB (uv_sealer database, batches collection) stores batch and cap traces; FANUC robot integration runs through FaRoC_Writer."}],["$","p","Features include connect/disconnect with threaded collection, register write workflow (Crush/Pressure/Cure Time), live pass/fail list, and date-based batch drilldown.",{"children":"Features include connect/disconnect with threaded collection, register write workflow (Crush/Pressure/Cure Time), live pass/fail list, and date-based batch drilldown."}]]}]]}],["$","section","Challenges and solutions",{"children":[["$","h2",null,{"className":"text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100","children":"Challenges and solutions"}],["$","div",null,{"className":"mt-4 space-y-5 text-base leading-7 text-zinc-600 dark:text-zinc-400","children":[["$","p","Variable-length traces were normalized with interpolation for consistent comparison and visualization.",{"children":"Variable-length traces were normalized with interpolation for consistent comparison and visualization."}],["$","p","Continuous robot polling was moved to a background thread to keep the UI responsive.",{"children":"Continuous robot polling was moved to a background thread to keep the UI responsive."}],["$","p","Calendar-based historical lookup plus per-cap graph drilldown reduced investigation time.",{"children":"Calendar-based historical lookup plus per-cap graph drilldown reduced investigation time."}]]}]]}],["$","section","Impact and operations",{"children":[["$","h2",null,{"className":"text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100","children":"Impact and operations"}],["$","div",null,{"className":"mt-4 space-y-5 text-base leading-7 text-zinc-600 dark:text-zinc-400","children":[["$","p","Improved operator visibility into cap quality outcomes and enabled faster review of production data in one internal tool.",{"children":"Improved operator visibility into cap quality outcomes and enabled faster review of production data in one internal tool."}],["$","p","Deployment is desktop Python for operators with local MongoDB and direct faroc robot communication.",{"children":"Deployment is desktop Python for operators with local MongoDB and direct faroc robot communication."}]]}]]}]]}]]}],["$","aside",null,{"className":"space-y-6","children":["$","div",null,{"className":"rounded-3xl border border-zinc-200/70 bg-white p-6 shadow-sm shadow-zinc-900/5 dark:border-zinc-700/60 dark:bg-zinc-900/80 dark:shadow-black/20","children":["$","dl",null,{"className":"space-y-5","children":[["$","div",null,{"children":[["$","dt",null,{"className":"text-xs font-semibold uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-400","children":"Role"}],["$","dd",null,{"className":"mt-2 text-sm text-zinc-700 dark:text-zinc-300","children":"Python Developer"}]]}],["$","div",null,{"children":[["$","dt",null,{"className":"text-xs font-semibold uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-400","children":"Timeline"}],["$","dd",null,{"className":"mt-2 text-sm text-zinc-700 dark:text-zinc-300","children":"May 2024 - March 2025 (internal operations tool)"}]]}],["$","div",null,{"children":[["$","dt",null,{"className":"text-xs font-semibold uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-400","children":"Stack"}],["$","dd",null,{"className":"mt-3 flex flex-wrap gap-2","children":[["$","span","Python",{"className":"rounded-full bg-zinc-100 px-3 py-1 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300","children":"Python"}],["$","span","CustomTkinter + Tkinter",{"className":"rounded-full bg-zinc-100 px-3 py-1 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300","children":"CustomTkinter + Tkinter"}],["$","span","Matplotlib + tkcalendar",{"className":"rounded-full bg-zinc-100 px-3 py-1 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300","children":"Matplotlib + tkcalendar"}],["$","span","FaRoC_Writer (FANUC)",{"className":"rounded-full bg-zinc-100 px-3 py-1 text-sm text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300","children":"FaRoC_Writer (FANUC)"}],[